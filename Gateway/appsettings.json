{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101/" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
